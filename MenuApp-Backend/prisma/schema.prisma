generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  rol       String   @default("owner")
  localId   Int?
  createdAt DateTime @default(now())
  local     Local?   @relation(fields: [localId], references: [id])
}

model Local {
  id              Int        @id @default(autoincrement())
  nombre          String
  logo            String?
  slug            String     @unique
  cbuAlias        String?
  linkPago        String?    @map("mercadoPagoLink")
  horarioApertura String?
  horarioCierre   String?
  direccion       String?
  diasAtencion    String?
  categorias      Category[]
  pedidos         Order[]
  mesas           Table[]
  users           User[]
  kitchens        Kitchen[]
}

model Table {
  id      Int    @id @default(autoincrement())
  numero  String
  localId Int
  local   Local  @relation(fields: [localId], references: [id])
}

model Category {
  id        Int       @id @default(autoincrement())
  localId   Int
  nombre    String
  orden     Int
  local     Local     @relation(fields: [localId], references: [id])
  productos Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  categoryId  Int
  nombre      String
  descripcion String?
  precio      Float
  imagen      String?
  activo      Boolean     @default(true)
  stock       Int         @default(0)
  kitchenId   Int?
  orderItems  OrderItem[]
  categoria   Category    @relation(fields: [categoryId], references: [id])
  kitchen     Kitchen?    @relation(fields: [kitchenId], references: [id])
}

model Kitchen {
  id        Int       @id @default(autoincrement())
  nombre    String
  localId   Int
  local     Local     @relation(fields: [localId], references: [id])
  productos Product[]
}

model Order {
  id             Int         @id @default(autoincrement())
  localId        Int
  mesa           String
  estado         String      @default("Recibido")
  total          Float
  metodoPago     String
  tipoOrden      String      @default("salon")
  pagoConfirmado Boolean     @default(false)
  createdAt      DateTime    @default(now())
  local          Local       @relation(fields: [localId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int
  productId      Int
  cantidad       Int
  precioUnitario Float
  aclaracion     String?
  producto       Product @relation(fields: [productId], references: [id])
  pedido         Order   @relation(fields: [orderId], references: [id])
}
