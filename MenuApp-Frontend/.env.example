# Copy to .env.local for local overrides (never commit secrets).
# Leave empty to use same-origin /api (Vite proxy in dev, Apache/PM2 in prod).

# Backend public origin (no trailing slash). Required when frontend is on Vercel
# and the API lives elsewhere (Render, Railway, VPS, etc.).
# Example: VITE_BACKEND_URL=https://tu-api.onrender.com
VITE_BACKEND_URL=
